# Environment configuration for Satoria Engineer Logbook Backend

PORT=3000
NODE_ENV=development

# Database Connection (TiDB Cloud / Local MySQL wire-compatible)
# CATATAN PEMISAHAN DEV & PROD:
# Jangan gunakan database/cluster produksi untuk development.
# 1. Gunakan fitur Branching di TiDB Cloud Serverless (buat branch 'dev' dari cluster utama)
# 2. Atau gunakan database terpisah (misal: 'satoria_logbook_dev' vs 'satoria_logbook_prod')
# 3. Atau gunakan MySQL/MariaDB lokal di port 3306/4000
DATABASE_URL="mysql://USER:PASSWORD@gateway01.ap-southeast-1.prod.alicloud.tidbcloud.com:4000/satoria_logbook_dev?sslaccept=strict"

# Authentication
JWT_SECRET="satoria-engineering-super-secret-jwt-key-2026"
JWT_EXPIRES_IN="24h"

# Allowed CORS Origins
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Email SMTP Notification Configuration
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="satoria_smtp_user"
SMTP_PASS="satoria_smtp_pass"
SMTP_FROM="noreply-logbook@satoria.co.id"
SMTP_ENABLED=false

# Sentry Error Monitoring (Free Tier: 10,000 errors/month)
# Dapatkan DSN gratis di https://sentry.io -> Create Project -> Express/Node.js
SENTRY_DSN=""

# Supabase Storage Configuration (Metode 1 - JS Client SDK)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="satoria-media"

# Cloudflare R2 / S3 Storage (Metode 2 - Opsional jika menggunakan S3 Object Storage)
# Kosongkan untuk fallback ke penyimpanan lokal (/public/uploads/avatars) pada mode development
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
